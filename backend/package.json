{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "migrate": "node ace migration:run --connection=owner",
    "migrate:rollback": "node ace migration:rollback --connection=owner",
    "seed:demo": "node ace db:seed --files ./database/seeders/demo_seeder.ts"
  },
  "imports": {
    "#exceptions/*": "./app/exceptions/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#modules/*": "./app/modules/*.js",
    "#shared/*": "./app/shared/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.2",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/luxon": "^3.7.5",
    "@types/node": "~26.6.2",
    "eslint": "^10.11.0",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/core": "^7.5.2",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/shield": "^9.0.0",
    "@japa/api-client": "^3.2.1",
    "@vinejs/vine": "^4.4.0",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "allowScripts": {
    "@swc/core": true,
    "esbuild": true,
    "fsevents": true
  },
  "prettier": "@adonisjs/prettier-config"
}
