{
  "name": "sistema-gestao-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "migrate": "node ace migration:run --connection=owner",
    "migrate:status": "node ace migration:status --connection=owner",
    "migrate:rollback": "node ace migration:rollback --connection=owner",
    "seed": "node ace db:seed --connection=owner",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "imports": {
    "#core/*": "./app/core/*.js",
    "#platform/*": "./app/platform/*.js",
    "#dynamic/*": "./app/dynamic/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js"
  },
  "dependencies": {
    "@adonisjs/core": "^6.21.0",
    "@adonisjs/cors": "^2.2.1",
    "@adonisjs/lucid": "^21.8.2",
    "@adonisjs/redis": "^9.2.0",
    "@vinejs/vine": "^3.0.1",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@adonisjs/eslint-config": "^2.1.2",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^1.4.1",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^4.0.0",
    "@japa/runner": "^4.5.0",
    "@swc/core": "^1.11.24",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "hot-hook": "^0.4.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.1.0",
    "prettier": "^3.8.1",
    "ts-node-maintained": "^10.9.5",
    "typescript": "~5.9.0",
    "yaml": "^2.9.1"
  },
  "prettier": "@adonisjs/prettier-config"
}
