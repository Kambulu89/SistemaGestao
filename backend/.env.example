# Copie para .env e ajuste. Nunca faça commit do .env nem de valores reais.
# Todas as variáveis são validadas no arranque (start/env_schema.ts): falta ou valor inválido => não arranca.

NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info
# `node ace generate:key` escreve aqui uma chave nova (mínimo 32 caracteres; diferente em cada ambiente)
APP_KEY=

# Origens permitidas pelo CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:4200

# Base de dados. Duas contas: runtime (aplicação, sujeita a RLS) e owner (só migrations/seeds).
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=sistema_gestao
DB_USER=sg_runtime
DB_PASSWORD=
DB_OWNER_USER=sg_owner
DB_OWNER_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=