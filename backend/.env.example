# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Base de dados (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=app
DB_PASSWORD=
DB_DATABASE=app
# Conta dona do esquema (só migrações: npm run migrate)
DB_OWNER_USER=app_owner
DB_OWNER_PASSWORD=

# Email: none (não envia) | dev-memory (só testes/desenvolvimento)
MAIL_DRIVER=none

# CORS: origens permitidas, separadas por vírgula
CORS_ORIGIN=http://localhost:4200
